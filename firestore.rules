rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Clasificación: un documento por jugador y escenario -> scores/{stage}_{uid}
    match /scores/{scoreId} {
      allow read: if true;

      allow create: if request.auth != null
        && scoreId == request.resource.data.stage + '_' + request.auth.uid
        && validScore(request.resource.data);

      // Solo se puede mejorar la marca propia
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && validScore(request.resource.data)
        && request.resource.data.stage == resource.data.stage
        && request.resource.data.rings > resource.data.rings;

      allow delete: if false;
    }

    // Tiempos de carrera: times/{courseId}_{uid}
    match /times/{timeId} {
      allow read: if true;
      allow create: if request.auth != null
        && timeId == request.resource.data.course + '_' + request.auth.uid
        && validTime(request.resource.data);
      // Solo se puede mejorar (bajar) el tiempo propio
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && validTime(request.resource.data)
        && request.resource.data.course == resource.data.course
        && request.resource.data.timeMs < resource.data.timeMs;
      allow delete: if false;
    }

    // Fantasma del récord mundial de cada circuito: ghosts/{courseId}
    match /ghosts/{course} {
      allow read: if true;
      allow create: if request.auth != null && validGhost(request.resource.data, course);
      // Solo se sustituye si el tiempo es mejor
      allow update: if request.auth != null && validGhost(request.resource.data, course)
        && request.resource.data.timeMs < resource.data.timeMs;
      allow delete: if false;
    }

    // Circuitos creados por los jugadores: circuits/{código de 6}
    match /circuits/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'author', 'name', 'stage', 'g', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.author is string && request.resource.data.author.size() <= 16
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 28
        && request.resource.data.stage in ['metropolis', 'archipelago', 'dusk', 'jungle', 'warzone', 'canyon', 'glacier', 'cyber', 'barcelona', 'madrid', 'nuevayork', 'everest', 'europa']
        && request.resource.data.g is string && request.resource.data.g.size() <= 400
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Copia del perfil en la nube: saves/{código de recuperación de 12}
    // El código es secreto (como una contraseña): sin él no se puede leer ni escribir.
    match /saves/{code} {
      allow get: if request.auth != null && code.matches('^[A-HJ-NP-Z2-9]{12}$');
      allow list: if false;
      allow create, update: if request.auth != null
        && code.matches('^[A-HJ-NP-Z2-9]{12}$')
        && request.resource.data.keys().hasOnly(['data', 'name', 'v', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() < 400000
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    function validGhost(d, course) {
      return d.keys().hasOnly(['uid', 'name', 'course', 'timeMs', 'f', 'updatedAt'])
        && d.uid == request.auth.uid
        && d.course == course
        && d.name is string && d.name.size() > 0 && d.name.size() <= 16
        && d.timeMs is int && d.timeMs >= 5000 && d.timeMs <= 3600000
        && d.f is string && d.f.size() <= 450000
        && d.updatedAt == request.time;
    }

    // Fantasma de la mejor vuelta de cada piloto: ghostsAll/{courseId}_{uid} (rivales del día)
    match /ghostsAll/{gid} {
      allow read: if true;
      allow create: if request.auth != null
        && gid == request.resource.data.course + '_' + request.auth.uid
        && validGhost(request.resource.data, request.resource.data.course);
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && validGhost(request.resource.data, resource.data.course)
        && request.resource.data.timeMs < resource.data.timeMs;
      allow delete: if false;
    }

    function validTime(d) {
      return d.keys().hasOnly(['uid', 'name', 'course', 'timeMs', 'country', 'updatedAt'])
        && (!('country' in d) || (d.country is string && d.country.size() <= 3))
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 16
        && d.course is string && d.course.size() <= 40
        && d.timeMs is int && d.timeMs >= 5000 && d.timeMs <= 3600000
        && d.updatedAt == request.time;
    }

    function validScore(d) {
      return d.keys().hasOnly(['uid', 'name', 'stage', 'rings', 'maxSpeed', 'updatedAt'])
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 16
        && d.stage in ['metropolis', 'archipelago', 'dusk', 'jungle', 'warzone', 'canyon', 'glacier', 'cyber', 'barcelona', 'madrid', 'nuevayork', 'everest', 'europa']
        && d.rings is int && d.rings >= 0 && d.rings <= 500
        && d.maxSpeed is number && d.maxSpeed >= 0 && d.maxSpeed <= 3000
        && d.updatedAt == request.time;
    }
  }
}
