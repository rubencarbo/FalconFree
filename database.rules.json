{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('meta/host').val() === auth.uid && !newData.exists()",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || (root.child('rooms/' + $code + '/players/' + auth.uid).exists() && !root.child('rooms/' + $code + '/players/' + data.child('host').val()).exists()))",
          ".validate": "newData.hasChildren(['host', 'mode', 'stage', 'course', 'state', 'startAt', 'round', 'createdAt']) && (newData.child('host').val() === auth.uid || newData.child('host').val() === data.child('host').val())",
          "host": {
            ".validate": "newData.isString()"
          },
          "mode": {
            ".validate": "newData.val() === 'free' || newData.val() === 'race' || newData.val() === 'battle'"
          },
          "stage": {
            ".validate": "newData.val() === 'metropolis' || newData.val() === 'archipelago' || newData.val() === 'dusk' || newData.val() === 'jungle' || newData.val() === 'warzone' || newData.val() === 'canyon' || newData.val() === 'glacier'"
          },
          "course": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "state": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'countdown' || newData.val() === 'running'"
          },
          "startAt": {
            ".validate": "newData.isNumber()"
          },
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          },
          "bk": {
            ".validate": "newData.val() === 'ffa' || newData.val() === 'teams' || newData.val() === 'coop' || newData.val() === 'koth' || newData.val() === 'tag' || newData.val() === 'royale' || newData.val() === 'boss'"
          },
          "bb": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
          },
          "bl": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
          },
          "bt": {
            ".validate": "newData.isNumber() && newData.val() >= 30 && newData.val() <= 1800"
          },
          "pub": {
            ".validate": "newData.isBoolean()"
          },
          "hn": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "root.child('rooms/' + $code + '/meta').exists() && newData.hasChildren(['name', 'color', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
            },
            "color": {
              ".validate": "newData.isNumber()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            },
            "team": {
              ".validate": "newData.val() === 'A' || newData.val() === 'B'"
            },
            "icon": {
              ".validate": "newData.val() === 'x' || newData.val() === 'o' || newData.val() === 'square' || newData.val() === 'star' || newData.val() === 'triangle' || newData.val() === 'arrow' || newData.val() === 'diamond' || newData.val() === 'plus'"
            },
            "plane": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "av": {
              ".validate": "newData.isString() && newData.val().length <= 14000"
            }
          }
        },
        "pos": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['x', 'y', 'z', 'yaw', 'pitch', 'roll', 's', 'f', 'hp', 'a', 't'])"
          }
        },
        "events": {
          ".indexOn": [
            "to"
          ],
          "$eid": {
            ".write": "auth != null && ((!data.exists() && root.child('rooms/' + $code + '/players/' + auth.uid).exists()) || (data.exists() && !newData.exists() && data.child('to').val() === auth.uid))",
            ".validate": "newData.hasChildren(['from', 'to', 'type', 'v', 't']) && newData.child('from').val() === auth.uid && newData.child('v').isNumber() && newData.child('v').val() <= 200 && (!newData.child('b').exists() || newData.child('b').val().beginsWith('bot'))"
          }
        },
        "results": {
          ".write": "auth != null && data.parent().child('meta/host').val() === auth.uid && !newData.exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name', 'time', 'round']) && newData.child('time').isNumber()"
          }
        },
        "rings": {
          ".write": "auth != null && data.parent().child('meta/host').val() === auth.uid && !newData.exists()",
          "$rid": {
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid && root.child('rooms/' + $code + '/players/' + auth.uid).exists()"
          }
        },
        "bots": {
          ".write": "auth != null && data.parent().child('meta/host').val() === auth.uid",
          "$bid": {
            ".validate": "$bid.beginsWith('bot') && newData.hasChildren(['x','y','z','n','t'])"
          }
        },
        "score": {
          "$id": {
            ".write": "auth != null && (auth.uid === $id || ($id.beginsWith('bot') && root.child('rooms/' + $code + '/meta/host').val() === auth.uid) || (!newData.exists() && root.child('rooms/' + $code + '/meta/host').val() === auth.uid))",
            ".validate": "newData.hasChildren(['k','d']) && newData.child('k').isNumber() && newData.child('d').isNumber()"
          },
          ".write": "auth != null && data.parent().child('meta/host').val() === auth.uid && !newData.exists()"
        },
        "tagit": {
          ".write": "auth != null && root.child('rooms/' + $code + '/players/' + auth.uid).exists()",
          ".validate": "!newData.exists() || (newData.hasChildren(['id', 's', 'by']) && newData.child('id').isString() && newData.child('s').isNumber() && newData.child('by').val() === auth.uid)"
        },
        "boss": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
          ".validate": "!newData.exists() || newData.hasChildren(['x', 'y', 'z', 'yaw', 'ph', 'hp', 't'])"
        },
        "talk": {
          ".write": "auth != null && root.child('rooms/' + $code + '/players/' + auth.uid).exists() && (!data.exists() || data.child('uid').val() === auth.uid || data.child('until').val() < now)",
          ".validate": "!newData.exists() || (newData.hasChildren(['uid', 'n', 'until']) && newData.child('uid').val() === auth.uid && newData.child('until').isNumber() && newData.child('until').val() <= now + 15000)"
        },
        "voice": {
          "$vid": {
            ".write": "auth != null && ((!data.exists() && root.child('rooms/' + $code + '/talk/uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('from').val() === auth.uid))",
            ".validate": "newData.hasChildren(['from', 'n', 't', 'ms', 'd']) && newData.child('from').val() === auth.uid && newData.child('d').isString() && newData.child('d').val().length <= 60000 && newData.child('ms').isNumber() && newData.child('ms').val() <= 5500"
          }
        },
        "pause": {
          ".write": "auth != null && root.child('rooms/' + $code + '/players/' + auth.uid).exists()",
          ".validate": "!newData.exists() || (newData.hasChildren(['by', 'n', 'at']) && newData.child('by').val() === auth.uid && newData.child('at').isNumber() && newData.child('n').isString())"
        },
        "mission": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid && !newData.exists()",
          "$team": {
            ".write": "auth != null && root.child('rooms/' + $code + '/players/' + auth.uid).exists() && ($team === 'all' || $team === 'A' || $team === 'B')",
            ".validate": "!newData.exists() || (newData.hasChildren(['lvl', 'kind', 'prog', 'goal', 'seed', 'x', 'y', 'z', 'yaw']) && newData.child('lvl').isNumber() && newData.child('lvl').val() >= 1 && newData.child('lvl').val() <= 999 && (!data.exists() || newData.child('lvl').val() >= data.child('lvl').val()) && newData.child('kind').isString() && newData.child('kind').val().length <= 12 && newData.child('prog').isNumber() && newData.child('goal').isNumber() && newData.child('goal').val() <= 60 && newData.child('seed').isNumber())",
            "bn": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "taken": {
              "$i": {
                ".validate": "newData.isBoolean()"
              }
            }
          }
        },
        "pausedMs": {
          ".write": "auth != null && root.child('rooms/' + $code + '/players/' + auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "lobbies": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
        ".validate": "newData.hasChildren(['host', 'mode', 'stage', 'n', 'state', 't']) && newData.child('host').isString() && newData.child('host').val().length <= 16 && newData.child('n').isNumber()"
      }
    }
  }
}