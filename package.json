{
  "name": "falconsky",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "deploy": "npm run build && firebase deploy",
    "build:artifact": "node scripts/build-artifact.mjs",
    "emulators": "firebase emulators:start --project demo-falconsky",
    "deploy:reglas": "firebase deploy --only database,firestore:rules,firestore:indexes",
    "deploy:multijugador": "firebase deploy --only database"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "firebase": "^13.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^2.0.5",
    "@types/three": "^0.187.0",
    "firebase-tools": "^15.37.0",
    "pbf": "^4.0.2",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
