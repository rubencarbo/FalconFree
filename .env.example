# El proyecto falconsky ya está configurado en .env.
# Para usar OTRO proyecto: copia este archivo a .env.local y rellénalo (tiene prioridad sobre .env).
# (Consola Firebase > Configuración del proyecto > Tus apps > App web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Realtime Database (multijugador). Consola > Realtime Database > copia la URL
VITE_FIREBASE_DATABASE_URL=

# Desarrollo local con emuladores (npm run emulators): pon 1
VITE_USE_EMULATORS=
